# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit real keys.
# ---------------------------------------------------------------------------

# Database connection string (Neon Postgres)
DATABASE_URL=
DIRECT_URL=
POSTGRES_URL=

# Google Gemini API key (Google AI Studio).
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model IDs read by scripts/probe-google.mjs.
# Sources:
#   https://ai.google.dev/gemini-api/docs/image-generation
#   https://ai.google.dev/api/generate-content
#
# GOOGLE_MODEL_VISION: gemini-2.5-flash was rejected by the live API with
#   "This model models/gemini-2.5-flash is no longer available to new users.
#    Please update your code to use models/gemini-3.8-flash"
# so the API's own replacement is used here.
#   https://ai.google.dev/gemini-api/docs/models/gemini-3.8-flash
GOOGLE_MODEL_NANO_BANANA=gemini-3.1-flash-image
GOOGLE_MODEL_VISION=gemini-3.8-flash
GOOGLE_MODEL_TEXT=gemini-3.8-flash

# Cloudflare Workers AI image worker (packages/providers Cloudflare adapter).
# CF_WORKER_URL is the deployed worker endpoint; CF_API_KEY is the API_KEY
# secret configured on that worker.
CF_WORKER_URL=https://chroma-image-api.<your-subdomain>.workers.dev
CF_API_KEY=

# Pollinations.ai API key.
# scripts/probe-pollinations.mjs currently targets the legacy keyless
# https://image.pollinations.ai surface and sends no key. If you switch the
# probe back to the current https://gen.pollinations.ai API, a key is required.
# Get one at https://enter.pollinations.ai/keys
POLLINATIONS_API_KEY=
